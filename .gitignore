# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
junit.xml
*.lcov

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# logs
*.log
/logs/

# env files — never commit real values.
# .env.example is the one exception: it must contain variable NAMES only.
.env
.env.local
.env.*.local
.env*
!.env.example

# secrets and credentials (Supabase secret keys, database URLs, etc.)
.supabase/
supabase/.branches/
supabase/.temp/
supabase/.env

# Drizzle Kit candidate output. Scratch SQL generated for review only — never
# an applied migration history. Reviewed SQL belongs in supabase/migrations/,
# which stays tracked. See docs/local-development.md.
/drizzle/

# local database dumps and generated state (never committed).
# Note: *.sql is deliberately NOT ignored — supabase/migrations/*.sql and
# supabase/seed.sql are reviewed source and must stay tracked.
*.dump
*.backup
/supabase/dumps/
**/service-role*
*.key
*.p12
*.pfx
*credentials*.json
service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
