# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
junit.xml
*.lcov

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# logs
*.log
/logs/

# env files — never commit real values.
# .env.example is the one exception: it must contain variable NAMES only.
.env
.env.local
.env.*.local
.env*
!.env.example

# secrets and credentials (Supabase service-role keys, database URLs, etc.)
.supabase/
supabase/.branches/
supabase/.temp/
supabase/.env
**/service-role*
*.key
*.p12
*.pfx
*credentials*.json
service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Wireframe capture output. Regenerable from the running app, and large
# enough (35 MB+ of PNGs) that committing it would weigh down every clone
# permanently. The files stay on disk for the client presentation deck.
design/wireframe-screenshots/
design/wireframe-review/
