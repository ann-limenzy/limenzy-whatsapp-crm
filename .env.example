# ---------------------------------------------------------------------------
# Limenzy CRM — environment configuration
#
# Copy to .env.local and fill in the values from your Supabase project
# (Dashboard → Project Settings → API Keys). Never commit .env.local.
#
# This application uses the CURRENT Supabase key model — publishable and
# secret keys. The legacy `anon` and `service_role` JWTs are not supported
# under any name.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time, so
# after changing them you must restart `next dev` or rebuild.
# ---------------------------------------------------------------------------

# --- Browser-safe (public) -------------------------------------------------
# These are shipped to the browser by design. The publishable key is safe to
# expose: it carries no privileges beyond what Row Level Security allows.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute origin used to build email verification and password-reset links,
# e.g. https://crm.example.com — no trailing slash.
# Optional: when unset the request's own origin is used, which is correct for
# local development and preview deployments.
NEXT_PUBLIC_SITE_URL=

# --- Server-only secrets ---------------------------------------------------
# NOT USED YET. Listed so the boundary is explicit.
#
# These must never be given a NEXT_PUBLIC_ prefix and must never be imported
# from a Client Component. The secret key bypasses Row Level Security
# entirely; leaking it to the browser would expose every workspace's data.
#
# SUPABASE_SECRET_KEY=         # Milestone 1C+ (admin operations, storage)
# DATABASE_URL=                # Milestone 1C (Drizzle runtime role)
# MIGRATION_DATABASE_URL=      # Milestone 1C (Drizzle migrations, owner role)
